{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axolotl Viewer",
  "version": "0.1.0",
  "identifier": "com.littlelollipop.axolotl-viewer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Axolotl Viewer — 图库查看器",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
